<?xml version="1.0" encoding="UTF-8"?>
<!-- Word add-in "Qur'on oyatlari". The task pane is the same website (web/), served
     from GitHub Pages. If you host it elsewhere, replace every
     https://abdullohukr.github.io/quranuz/ below. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>5392de1f-c12d-4292-8fb5-64c79333149e</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>quranuz</ProviderName>
  <DefaultLocale>uz-UZ</DefaultLocale>
  <DisplayName DefaultValue="Қуръон оятлари"/>
  <Description DefaultValue="Оятларни топиш ва ўзбекча таржимаси билан Word ҳужжатига қўйиш"/>
  <IconUrl DefaultValue="https://abdullohukr.github.io/quranuz/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://abdullohukr.github.io/quranuz/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://github.com/abdullohukr/quranuz"/>
  <AppDomains>
    <AppDomain>https://abdullohukr.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Document"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://abdullohukr.github.io/quranuz/index.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="Repo.Url"/>
          </GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="QuranUz.Group">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="QuranUz.Open">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>QuranUzPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://abdullohukr.github.io/quranuz/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://abdullohukr.github.io/quranuz/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://abdullohukr.github.io/quranuz/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://abdullohukr.github.io/quranuz/index.html"/>
        <bt:Url id="Repo.Url" DefaultValue="https://github.com/abdullohukr/quranuz"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Қуръон оятлари"/>
        <bt:String id="Group.Label" DefaultValue="Қуръон"/>
        <bt:String id="Button.Label" DefaultValue="Оятлар"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Бош саҳифадаги «Оятлар» тугмасини босинг."/>
        <bt:String id="Button.Tooltip" DefaultValue="Оят қидириш ва таржимаси билан ҳужжатга қўйиш"/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
