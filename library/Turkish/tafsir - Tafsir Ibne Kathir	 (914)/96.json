[[1,1,"Yaratan Rabbının adıyla oku."],[2,2,"O; insanı pıhtılaşmış kandan yarattı."],[3,3,"Oku, Rabbın nihayetsiz kerem sahibidir."],[4,4,"Ki O, kalemle öğretti."],[5,5,"İnsana bilmediğini öğretmiştir."],[6,6,"Hayır; insan azgınlık eder."],[7,7,"Kendini müstağni gördüğü için."],[8,8,"Dönüş, şüphesiz ancak Rabbınadır."],[9,9,"O yasaklayanı gördün mü?"],[10,10,"Bir kulu, namaz kılarken?"],[11,11,"Gördün mü; ya o kul doğru yolda ise?"],[12,12,"Veya takvayı emrettiyse?"],[13,13,"Gördün mü; ya yalan saydı ve yüz çevirdi ise?"],[14,14,"Bilmez mi ki; Allah gerçekten görmektedir?"],[15,15,"Ama bundan vazgeçmezse; andolsun ki; onu alnından tutup sürükleriz."],[16,16,"Yalancı, günahkar alnından."],[17,17,"Öyleyse topluluğunu çağırsın dursun."],[18,18,"Biz de zebanileri çağırırız."],[19,19,"Sakın, sen ona uyma. Secde et ve yaklaş."]]