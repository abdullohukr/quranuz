[[1,1,"Yüzünü asıp çevirdi,"],[2,2,"Kendisine a´ma geldi diye."],[3,3,"Ne bilirsin belki de o, temizlenecekti."],[4,4,"Yahut öğüt alacaktı da bu, kendisine fayda verecekti."],[5,5,"Ama kendisini müstağni gören."],[6,6,"İşte sen, onu karşına alıyorsun."],[7,7,"Halbuki onun temizlenmemesinden sana ne?"],[8,8,"Ama sana koşarak gelen,"],[9,9,"Ki o, korkar durumdadır."],[10,10,"Sen ona aldırmıyor, oyalanıyorsun."],[11,11,"Sakın; çünkü bu, bir öğüttür."],[12,12,"Dileyen onu düşünüp öğüy alır."],[13,13,"O, çok şerefli sahifelerdedir."],[14,14,"Yüceltilmiş ve temizlenmiştir."],[15,15,"Katiblerin elleriyle."],[16,16,"Kıymetli, saygıdeğer."],[17,17,"Canı çıksın o insanın. Ne de nankördür o."],[18,18,"Neden yaratmış onu?"],[19,19,"Meniden yarattı onu da, takdir etti."],[20,20,"Sonra ona tutacağı yolu kolaylaştırmış."],[21,21,"Sonra da onu öldürdü, kabre koydu."],[22,22,"Sonra dilediğinde onu tekrar çıkaracak."],[23,23,"Hayır; Allah´ın emrettiğini yerine getirmemiştir."],[24,24,"Öyle ya insan yiyeceğine bir baksın."],[25,25,"Doğrusu Biz; o suyu, bol bol indirdik."],[26,26,"Sonra toprağı iyiden iyiye yardık."],[27,27,"Böylece orada tane bitirdik."],[28,28,"Üzüm ve yonca,"],[29,29,"Zeytin ve hurma,"],[30,30,"Sık ve bol ağaçlı bahçeler."],[31,31,"Meyve ve mer´a."],[32,32,"Sizin ve hayvanlarınızın faydalanması için."],[33,33,"O büyük gürültü geldiği zaman;"],[34,34,"Kişinin kaçacağı gün; kardeşinden,"],[35,35,"Anasından ve babasından."],[36,36,"Eşinden ve oğullarından."],[37,37,"O gün; herkesin kendisine yeter bir işi vardır."],[38,38,"O gün; yüzler vardır, parıl parıl parlar."],[39,39,"Güleç, sevinçli,"],[40,40,"O gün; yüzler de vardır, tozlanmış,"],[41,41,"Bir karanlık bürümüştür."],[42,42,"İşte bunlar; kafirler ve facirlerdir."]]