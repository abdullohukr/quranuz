[[1,1,"Güneş dürüldüğü zaman;"],[2,2,"Yıldızlar döküldüğü zaman;"],[3,3,"Dağlar yürütüldüğü zaman;"],[4,4,"Gebe develer salıverildiği zaman;"],[5,5,"Vahşi hayvanlar bir araya toplandığı zaman;"],[6,6,"Denizler kaynatıldığı zaman;"],[7,7,"Ruhlar çiftleştirildiği zaman;"],[8,8,"Diri diri gömülen kız çocuğuna sorulduğu zaman;"],[9,9,"Hangi günahtan dolayı öldürüldüğü,"],[10,10,"Sayfalar açıldığı zaman;"],[11,11,"Gök yerinden oynatıldığı zaman;"],[12,12,"Cehennem kızıştırıldığı zaman;"],[13,13,"Ve Cennet yaklaştırıldığı zaman;"],[14,14,"Kişi önceden ne hazırladığını bilecektir."],[15,15,"Andolsun sinenlere;"],[16,16,"Akıp akıp yuvalarına girenlere;"],[17,17,"kararmaya başlayan geceye;"],[18,18,"Ağarmaya başlayan sabaha;"],[19,19,"Şüphesiz ki bu; şerefli bir elçinin sözüdür."],[20,20,"Arş´ın sahibi katında değerlidir ve güçlüdür."],[21,21,"Kendisine uyulandır, emindir."],[22,22,"Sizin arkadaşınız asla deli değildir."],[23,23,"Andolsun ki; onu, apaçık ufukta görmüştür."],[24,24,"Gaybdan ötürü o, asla suçlu da değildir."],[25,25,"Bu, kovulmuş şeytanın sözü değildir."],[26,26,"Böyleyken nereye gidiyorsunuz?"],[27,27,"O; ancak alemler için bir öğüttür."],[28,28,"Sizden doğru olmak isteyenler için."],[29,29,"Alemlerin Rabbı olan Allah dilemedikçe, sizler dileyemezsiniz."]]