  <Version>1.3.1.0</Version>
  <ProviderName>Abdulloh Hamidulloh al-Madiyniy</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Khatt al-Quran">
    <Override Locale="ar-SA" Value="خط القرآن"/>
    <Override Locale="fa-IR" Value="خط القرآن"/>
    <Override Locale="ur-PK" Value="خط القرآن"/>
  </DisplayName>
  <Description DefaultValue="Find Quran ayahs and insert them into your document: the Arabic text of several mushafs, translations in 90+ languages, tafsirs, isti'adhah, basmalah and a source reference.">
    <Override Locale="uz-UZ" Value="Оятларни топиш ва ҳужжатга қўйиш: турли мусҳафлардаги араб матни, 90+ тилдаги таржималар, тафсирлар, аъузу, басмала ва манба ҳаволаси."/>
    <Override Locale="uz-Cyrl-UZ" Value="Оятларни топиш ва ҳужжатга қўйиш: турли мусҳафлардаги араб матни, 90+ тилдаги таржималар, тафсирлар, аъузу, басмала ва манба ҳаволаси."/>
    <Override Locale="ru-RU" Value="Поиск аятов Корана и вставка в документ: арабский текст разных мусхафов, переводы на 90+ языках, тафсиры, истиаза, басмала и ссылка на источник."/>
    <Override Locale="ar-SA" Value="ابحث عن آيات القرآن وأدرجها في المستند: النص العربي بعدة مصاحف، وترجمات بأكثر من 90 لغة، وتفاسير، والاستعاذة والبسملة ومرجع الآية."/>
    <Override Locale="uz-Latn-UZ" Value="Oyatlarni topish va hujjatga qoʻyish: turli mushaflardagi arab matni, 90+ tildagi tarjimalar, tafsirlar, aʼuzu, basmala va manba havolasi."/>
    <Override Locale="tr-TR" Value="Kur'an ayetlerini bulup belgeye ekleyin: çeşitli mushaflarda Arapça metin, 90+ dilde mealler, tefsirler, euzü, besmele ve kaynak."/>
    <Override Locale="fr-FR" Value="Trouvez des versets du Coran et insérez-les dans votre document : texte arabe de plusieurs mushafs, traductions en 90+ langues, tafsirs, isti‘adha, basmala et référence."/>
    <Override Locale="de-DE" Value="Koranverse finden und ins Dokument einfügen: arabischer Text mehrerer Mushafe, Übersetzungen in 90+ Sprachen, Tafsire, Isti‘adha, Basmala und Quellenangabe."/>
    <Override Locale="es-ES" Value="Busque aleyas del Corán e insértelas en su documento: texto árabe de varios mushafs, traducciones en 90+ idiomas, tafsires, isti‘adha, basmala y referencia."/>
    <Override Locale="kk-KZ" Value="Құран аяттарын тауып, құжатқа қою: әртүрлі мұсхафтардағы араб мәтіні, 90+ тілдегі аудармалар, тәпсірлер, ағузу, бисмилла және дереккөз."/>
    <Override Locale="ky-KG" Value="Куран аяттарын таап, документке коюу: ар кандай мусхафтардагы араб тексти, 90+ тилдеги котормолор, тафсирлер, аузу, басмала жана булак."/>
    <Override Locale="tg-Cyrl-TJ" Value="Ёфтани оятҳои Қуръон ва гузоштан ба ҳуҷҷат: матни арабии мусҳафҳои гуногун, тарҷумаҳо бо 90+ забон, тафсирҳо, аъузу, басмала ва манбаъ."/>
    <Override Locale="az-Latn-AZ" Value="Quran ayələrini tapıb sənədə əlavə edin: müxtəlif mushaflarda ərəb mətni, 90+ dildə tərcümələr, təfsirlər, istiazə, bəsmələ və mənbə."/>
    <Override Locale="fa-IR" Value="آیات قرآن را بیابید و در سند درج کنید: متن عربی چند مصحف، ترجمه به بیش از ۹۰ زبان، تفسیرها، استعاذه، بسمله و ارجاع."/>
    <Override Locale="ur-PK" Value="قرآن کی آیات تلاش کر کے دستاویز میں داخل کریں: مختلف مصاحف کا عربی متن، 90+ زبانوں میں تراجم، تفاسیر، تعوذ، بسملہ اور حوالہ۔"/>
    <Override Locale="id-ID" Value="Temukan ayat Al-Qur'an dan sisipkan ke dokumen: teks Arab berbagai mushaf, terjemahan dalam 90+ bahasa, tafsir, ta'awudz, basmalah, dan rujukan."/>
    <Override Locale="ms-MY" Value="Cari ayat al-Quran dan masukkan ke dalam dokumen: teks Arab pelbagai mushaf, terjemahan dalam 90+ bahasa, tafsir, ta‘awwuz, basmalah dan rujukan."/>
    <Override Locale="bn-BD" Value="কুরআনের আয়াত খুঁজে ডকুমেন্টে যুক্ত করুন: বিভিন্ন মুসহাফের আরবি পাঠ, ৯০+ ভাষায় অনুবাদ, তাফসির, আউযুবিল্লাহ, বিসমিল্লাহ ও সূত্র।"/>
    <Override Locale="bn-IN" Value="কুরআনের আয়াত খুঁজে ডকুমেন্টে যুক্ত করুন: বিভিন্ন মুসহাফের আরবি পাঠ, ৯০+ ভাষায় অনুবাদ, তাফসির, আউযুবিল্লাহ, বিসমিল্লাহ ও সূত্র।"/>
    <Override Locale="hi-IN" Value="क़ुरआन की आयतें खोजें और दस्तावेज़ में डालें: कई मुसहफ़ों का अरबी पाठ, 90+ भाषाओं में अनुवाद, तफ़सीर, तअव्वुज़, बिस्मिल्लाह और स्रोत।"/>
    <Override Locale="zh-CN" Value="查找古兰经经文并插入文档：多种经文版本的阿拉伯原文、90 多种语言的译文、经注、求护词、太斯米及出处。"/>
    <Override Locale="ko-KR" Value="쿠란 구절을 찾아 문서에 삽입: 여러 무스하프의 아랍어 원문, 90개 이상 언어의 번역, 타프시르, 이스티아자, 바스말라와 출처."/>
    <Override Locale="ja-JP" Value="クルアーンの節を探して文書に挿入：複数のムスハフのアラビア語本文、90 以上の言語の訳文、タフスィール、イスティアーザ、バスマラと出典。"/>
  </Description>
